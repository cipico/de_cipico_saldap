<?xml version="1.0"?>
<extension key="de_cipico_saldap" type="module">
  <file>de_cipico_saldap</file>
  <name>de_cipico_saldap</name>
  <description>LDAP Authentication for CiviCRM Standalone</description>
  <license>AGPL-3.0</license>
  <authors>
    <author>
      <name>Nico Friedrich</name>
      <email>n.friedrich@cipico.de</email>
      <role>Maintainer</role>
    </author>
  </authors>
  <urls>
    <url desc="Main Extension Page">https://github.com/cipico/de_cipico_saldap</url>
    <url desc="Documentation">https://github.com/cipico/de_cipico_saldap</url>
    <url desc="Support">https://github.com/cipico/de_cipico_saldap/issues</url>
    <url desc="Licensing">https://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-06-26</releaseDate>
  <version>1.0.0</version>
  <develStage>alpha</develStage>
  <compatibility mode="semver">
    <ver>6.13</ver>
  </compatibility>
  <php_compatibility mode="list">
    <ver>8.1</ver>
    <ver>8.2</ver>
    <ver>8.3</ver>
    <ver>8.4</ver>
  </php_compatibility>
  <smarty_compatibility mode="list">
    <ver>5</ver>
  </smarty_compatibility>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <civix>
    <namespace>CRM/DeCipicoSaldap</namespace>
    <format>25.10.2</format>
    <angularModule>crmDeCipicoSaldap</angularModule>
    <setting-page-title>LDAP Server Settings</setting-page-title>
  </civix>
  <mixins>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>setting-admin@1.0.1</mixin>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>smarty@1.0.3</mixin>
  </mixins>
</extension>
